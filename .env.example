# XLock runs fully in local-first mode without these values.
# Add these in Vercel Project Settings → Environment Variables to enable cloud sync.

VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Older projects may use an anon key instead:
# VITE_SUPABASE_ANON_KEY=

# Optional. Allows multiple independent XLock state profiles for the same user.
VITE_XLOCK_PROFILE_KEY=primary
